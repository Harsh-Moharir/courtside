{
  "name": "courtside",
  "version": "1.0.0",
  "description": "Basketball tournament management: teams, auction, fixtures, live scoring, standings, playoffs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:concurrency": "tsx tests/concurrency/run.ts",
    "test:e2e": "playwright test --trace off",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "seed": "tsx scripts/seed.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "add-admin": "tsx scripts/add-admin.ts"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "supabase": "^2.122.1",
    "tailwindcss": "~3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.10.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}